{
  "manifest_version": 3,
  "name": "StarTab",
  "version": "5.0.0",
  "description": "Cosmic browser start page — search, shortcuts, tab kanban, bookmarks.",
  "permissions": ["tabs", "activeTab", "storage", "topSites", "bookmarks"],
  "chrome_url_overrides": { "newtab": "index.html" },
  "background": { "service_worker": "background.js" },
  "action": {
    "default_title": "StarTab",
    "default_icon": { "16": "icons/icon16.png", "48": "icons/icon48.png" }
  },
  "icons": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" }
}
